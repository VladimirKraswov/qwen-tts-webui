FROM nvidia/cuda:12.8.0-runtime-ubuntu24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-dev python3-venv \
    ffmpeg sox libsox-fmt-all libsndfile1 git curl \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /venv
ENV PATH="/venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

COPY backend/requirements.ai.txt /tmp/requirements.ai.txt

RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip setuptools wheel && \
    # Install PyTorch nightly that supports Blackwell (sm_120)
    pip install --index-url https://download.pytorch.org/whl/nightly/cu126 \
      torch torchvision torchaudio && \
    pip install -r /tmp/requirements.ai.txt && \
    pip install flash-attn --no-build-isolation

RUN git clone https://github.com/dffdeeq/Qwen3-TTS-streaming.git /opt/qwen-tts-streaming && \
    pip install -e /opt/qwen-tts-streaming --no-deps